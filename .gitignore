# Rust build output
/target/
**/*.rs.bk
*.pdb

# NOTE: Cargo.lock is intentionally TRACKED (one workspace, one lockfile:
# core crates, Tauri shell, CLI, xtask). Do not ignore it.

# Frontend (Vite + Tauri dev)
node_modules/
dist/
dist-ssr/
*.local
logs/
*.log
npm-debug.log*

# IDEs and editors
.vscode/*
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~
*.orig
*.rej

# OS leftovers
.DS_Store
Thumbs.db
desktop.ini

# PlotVale runtime leftovers (never commit these)
/tmp/
*.plotvale.tmp
*-backups/
*.plotvale.bak

# Distribution packages built locally
/dist/
*.msi
*.dmg
*.AppImage
*.deb

# Coverage and profiling
lcov.info
tarpaulin-report.*
/coverage/
*.profraw
*.profdata

# Documentation build (Sphinx) and the local Python environment
/docs/_build/
.venv/
__pycache__/

# Local secrets (never commit)
.env
.env.*
!.env.example
